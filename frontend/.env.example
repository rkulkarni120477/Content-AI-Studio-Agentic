# CAS frontend talks only to CAS backend, never directly to DIS.
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME=Content AI Studio
VITE_APP_VERSION=1.0.0
VITE_TOKEN_KEY=content_ai_jwt
VITE_ENABLE_PLAGIARISM_CHECK=true
VITE_ENABLE_ASYNC_GENERATION=true
VITE_ENABLE_COST_TRACKING=true
VITE_JOB_POLL_INTERVAL_MS=3000
VITE_API_TIMEOUT_MS=120000
# Optional external print production workflow (Export tab button)
VITE_PRINT_WORKFLOW_URL=
