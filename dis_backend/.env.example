# DIS backend env - S3 only
#
# This value is baked into every S3 key this server writes/reads
# (raw/<namespace>/<ENVIRONMENT>/<job_id>/..., and the Source Library index
# at processed/<namespace>/<ENVIRONMENT>/source_index/source_list.json). If
# this server already has uploads under a given value, changing it makes DIS
# look under a NEW path and the Source Library UI goes blank for that
# namespace — the old objects are untouched, just no longer referenced. See
# DIS_ENV_BIFURCATION_WORKFLOW.txt phase 1 before changing this on a server
# that already has data.
ENVIRONMENT=development
DEBUG=true

# Internal service token shared only with CAS backend. Do not expose to frontend.
# Use a DIFFERENT value per environment — a leaked dev token must not
# authenticate against prod DIS.
DIS_SERVICE_TOKEN=dev-dis-token

# S3-only storage. Give dev and prod SEPARATE buckets (e.g.
# content-ai-studio / content-ai-studio-dev) so a dev upload can never be
# mistaken for, or collide with, a prod one.
DIS_S3_BUCKET=content-ai-studio
DIS_S3_BASE_PREFIX=DIS
# S3 bucket region. Deliberately separate from AWS_REGION below, which is
# where Bedrock runs — reading AWS_REGION here previously pointed DIS at the
# wrong regional S3 endpoint and produced silent connection timeouts. See the
# comment in config/settings.py above _apply_store_env_overrides.
DIS_S3_REGION=us-east-1
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# ── Backing stores: NOT configured here ────────────────────────────────────
# The DIS Postgres and the OpenSearch domain/index come from the client YAML and
# nothing else — for AIM, config/clients/aim.yaml (structure_store.url,
# vector_store.endpoint, vector_store.index_name). Dev and prod read the same
# file and therefore the same stores: DIS is one shared corpus.
#
# The DIS_STRUCTURE_STORE_URL / DIS_VECTOR_STORE_ENDPOINT / DIS_VECTOR_STORE_INDEX
# overrides (and their _<CLIENT> forms) were removed on 2026-08-27. Setting them
# now does nothing. Dev had exported the first one, pointing at an empty sibling
# database, and every Block-9 digest build failed with "No calendar found for
# block 'Block 9'" while the committed YAML named the populated store — a
# deployment cannot be diagnosed from the repo when an env var outranks it.
# To repoint a store, edit the client YAML.

# Optional if not using ~/.aws/credentials or IAM role
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# LLM settings
USE_BEDROCK=true
ANTHROPIC_API_KEY=
