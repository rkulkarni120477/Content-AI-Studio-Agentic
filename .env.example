# To run this project locally, follow these steps:
# python -m uvicorn app.main:app --reload --port 8000 - backend
# npm install , npm run dev - frontend

# =============================================================================
# Content AI Studio — Environment Variable Reference
# =============================================================================
# Copy this file to .env and fill in real values.
# Never commit .env to version control.
#
# Variable resolution order:
#   1. Real environment variables (Docker / EC2 / GitHub Actions)
#   2. Values in this .env file
#   3. Defaults defined in app/core/config.py
# =============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_VERSION=1.0.0
APP_ENV=development        # development | staging | production

# Comma-separated list of allowed CORS origins for the React frontend.
# In production: set to your exact frontend domain, e.g. https://app.yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------------------------------------------------------------------------
# Security  ⚠️  REQUIRED — must be set to a long random string in production
# ---------------------------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET_STRING
JWT_TOKEN_EXPIRE_DAYS=7

# ---------------------------------------------------------------------------
# Database  ⚠️  REQUIRED
# ---------------------------------------------------------------------------
# Production: PostgreSQL on AWS RDS
DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/contentai

# ---------------------------------------------------------------------------
# Redis & Celery  ⚠️  REQUIRED for background jobs
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ---------------------------------------------------------------------------
# OpenAI
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o

# ---------------------------------------------------------------------------
# AWS Bedrock (Claude models)
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_DEFAULT_REGION=ap-south-1
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-5-20250929-v1:0

# ---------------------------------------------------------------------------
# Editor image uploads (S3)
# ---------------------------------------------------------------------------
# Editor images are stored in the same S3 bucket DIS uses (reuses AWS creds
# above), under a "<DIS_S3_BASE_PREFIX>/cas-assets/" prefix. The upload tries a
# per-object public-read ACL and falls back to no-ACL when the bucket has ACLs
# disabled (Object Ownership = bucket-owner-enforced, as content-ai-studio does).
# For the returned URLs to actually render in <img>, the bucket must serve that
# prefix publicly — add a bucket policy granting s3:GetObject on
# arn:aws:s3:::<bucket>/<prefix>/cas-assets/* and adjust Block Public Access.
# (Alternatively, switch to a private-bucket + CAS presigned-URL proxy.)
# Leave DIS_S3_BUCKET empty to disable uploads (the editor still supports image
# URLs). AWS_ENDPOINT_URL is only for LocalStack/dev.
#
# This is the SAME variable DIS itself reads for raw/processed uploads
# (dis_backend/.env) — set it to match whichever bucket this CAS instance's
# DIS is pointed at (content-ai-studio for prod, content-ai-studio-dev for
# dev), or editor images and DIS uploads end up in different buckets than
# expected. See DIS_ENV_BIFURCATION_WORKFLOW.txt.
DIS_S3_BUCKET=
DIS_S3_BASE_PREFIX=
# The DIS bucket may live in a different AWS account/region than the Bedrock
# creds above. Set these to the DIS bucket's region + credentials; if left blank
# they fall back to AWS_* above.
DIS_S3_REGION=
DIS_S3_ACCESS_KEY_ID=
DIS_S3_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL=
CAS_ASSETS_MAX_UPLOAD_MB=5
# Leave false when the bucket is public via a bucket policy (recommended for the
# shared DIS bucket, which has ACLs disabled). Set true only for an ACL-enabled bucket.
CAS_ASSETS_PUBLIC_ACL=false

# ---------------------------------------------------------------------------
# LLM behaviour
# ---------------------------------------------------------------------------
PROMPTOPS_API_TIMEOUT_SECONDS=120
PROMPTOPS_LLM_MAX_RETRIES=1
PROMPTOPS_LLM_FALLBACK_ENABLED=true

# ---------------------------------------------------------------------------
# Copyleaks plagiarism detection
# ---------------------------------------------------------------------------
COPYLEAKS_EMAIL=your@email.com
COPYLEAKS_API_KEY=...
COPYLEAKS_PRODUCT=businesses    # businesses | education

# ---------------------------------------------------------------------------
# Pagination defaults
# ---------------------------------------------------------------------------
PROMPTOPS_EDITOR_PAGE_SIZE=25
PROMPTOPS_WORKFLOW_PAGE_SIZE=100
PROMPTOPS_ANALYTICS_PAGE_SIZE=50

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
PROMPTOPS_LOG_LEVEL=INFO
PROMPTOPS_LOG_COLOR=false
PROMPTOPS_LOG_FULL_PROMPTS=false    # WARNING: logs full prompts — disable in production

# Phoenix — self-hosted LLM tracing (see PHOENIX_SETUP.md). Mandatory, not
# optional — leaving these unset breaks the whole `docker compose up`, not
# just tracing. CAS's api/celery containers reach it over the compose network
# by service name.
PHOENIX_CONTAINER_NAME=contentai_phoenix
PHOENIX_COLLECTOR_ENDPOINT=http://phoenix:6006/v1/traces
PHOENIX_BASE_URL=http://phoenix:6006
PHOENIX_PROJECT_NAME=content-ai-studio
PHOENIX_API_KEY=
# Same host/user/password as DATABASE_URL above (same Postgres server, e.g.
# RDS) — just a different database name. NOT "localhost": that resolves to
# the phoenix container itself, and there is no separate postgres service in
# this compose file. The database itself is created automatically on first
# startup (promptops_app.database.ensure_phoenix_database) — no manual step.
PHOENIX_SQL_DATABASE_URL=postgresql://postgres:password@your-postgres-host:5432/phoenix

# ---------------------------------------------------------------------------
# Feature flags
# ---------------------------------------------------------------------------
PROMPTOPS_SYNC_QUALITY_CHECKS=false
PROMPTOPS_APPROVAL_SLA_HOURS=24

# Reverse pipeline — Canvas IMSCC course import. Keep false until QA sign-off.
IMPORT_COURSES_ENABLED=false

# CE Agent Review (checklist-based content review). Keep false until the feature
# is complete; false = app behaves exactly like today.
CE_REVIEW_ENABLED=false
# Retention (days) for CE review finding/result detail; 0 = keep forever (off).
CE_REVIEW_RETENTION_DAYS=0

# ---------------------------------------------------------------------------
# DIS / Source Library integration
# ---------------------------------------------------------------------------
DIS_ENABLED=true
DIS_API_BASE_URL=http://127.0.0.1:8010/v1
DIS_API_TIMEOUT_SECONDS=30
DIS_SERVICE_TOKEN=dev-dis-token

# Optional. If empty, CAS reads config/dis_access.json.
DIS_ACCESS_CONFIG_PATH=

# Optional env overrides for deployment. Local dev can keep these empty.
DIS_AVAILABLE_CLIENTS=
DIS_SUPER_ADMIN_USERNAMES=
DIS_SUPER_ADMIN_ROLES=
DIS_USER_CLIENT_MAP=
DIS_DEFAULT_CLIENT_ID=
DIS_DEFAULT_TENANT_ID=

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0
